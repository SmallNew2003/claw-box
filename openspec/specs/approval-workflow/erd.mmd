        varchar last_update_by_上次更新人
        timestamp last_update_time_上次更新时间
        tinyint instance_state_实例状态
        timestamp end_time_结束时间
        bigint duration_ms_处理耗时毫秒
    }

    FLW_HIS_TASK_历史任务 {
        bigint id_主键 PK
        varchar tenant_id_租户ID
