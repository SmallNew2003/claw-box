erDiagram
    SYS_USER_用户 ||--o{ COMPONENT_组件 : 一对多_所有者
    COMPONENT_组件 ||--o{ COMPONENT_CAPABILITY_组件能力 : 一对多_能力
    COMPONENT_组件 ||--o{ AGENT_COMPONENT_BINDING_智能体组件绑定 : 一对多_绑定
    AGENT_智能体 ||--o{ AGENT_COMPONENT_BINDING_智能体组件绑定 : 一对多_绑定

    SYS_USER_用户 {
        bigint id_主键 PK
        varchar username_登录账号 UK
        varchar name_姓名
    }

    COMPONENT_组件 {
        bigint id_主键 PK
        varchar component_id_组件ID UK
        varchar name_组件名称
        varchar type_code_组件类型
        varchar scope_code_作用域
        bigint owner_id_所有者ID FK
        varchar status_code_状态
        varchar endpoint_接入地址
        varchar protocol_code_协议类型
        text configuration_json_配置参数JSON
        text description_组件描述
        varchar version_版本号
        bigint created_by_创建人
        bigint updated_by_更新人
        timestamp create_time_创建时间
        timestamp update_time_更新时间
    }

    COMPONENT_CAPABILITY_组件能力 {
        bigint id_主键 PK
        varchar capability_id_能力ID UK
        bigint component_id_组件ID FK
        varchar function_name_功能名称
        text description_功能描述
        text parameters_json_参数列表JSON
        text examples_json_使用示例JSON
        int sort_order_排序
        bigint created_by_创建人
        timestamp create_time_创建时间
    }

    AGENT_COMPONENT_BINDING_智能体组件绑定 {
        bigint id_主键 PK
        varchar binding_id_绑定ID UK
        bigint agent_id_智能体ID FK
        bigint component_id_组件ID FK
        varchar binding_type_code_绑定类型
        timestamp binding_time_绑定时间
        varchar status_code_状态
        bigint created_by_创建人
        bigint updated_by_更新人
        timestamp create_time_创建时间
        timestamp update_time_更新时间
    }

    AGENT_智能体 {
        bigint id_主键 PK
        varchar agent_name_智能体名称
        varchar agent_code_智能体编码 UK
        varchar agent_type_code_智能体类型
        varchar status_code_状态
    }
